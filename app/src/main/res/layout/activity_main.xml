<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1030">

    <!-- Main screen: status bar, camera on top, controls underneath -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Status bar -->
        <LinearLayout
            android:id="@+id/hud"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="invisible">
            <TextView android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Connecting..."
                android:textColor="#AAB4FF"
                android:textSize="14sp"/>
            <TextView android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battery --"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Camera view (16:9, full width) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:background="#000000"
            android:visibility="invisible"
            app:use_controller="false"
            app:resize_mode="fixed_width"
            app:surface_type="texture_view"/>

        <!-- Controls panel under the camera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Driving pad -->
                <GridLayout
                    android:id="@+id/dpad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="3"
                    android:visibility="invisible">
                    <ImageButton android:id="@+id/dFL" android:src="@drawable/ic_up_left"    android:contentDescription="Forward left"  style="@style/Pad"/>
                    <ImageButton android:id="@+id/dF"  android:src="@drawable/ic_up"         android:contentDescription="Forward"       style="@style/Pad"/>
                    <ImageButton android:id="@+id/dFR" android:src="@drawable/ic_up_right"   android:contentDescription="Forward right" style="@style/Pad"/>
                    <ImageButton android:id="@+id/dL"  android:src="@drawable/ic_left"       android:contentDescription="Turn left"     style="@style/Pad"/>
                    <Space android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="4dp"/>
                    <ImageButton android:id="@+id/dR"  android:src="@drawable/ic_right"      android:contentDescription="Turn right"    style="@style/Pad"/>
                    <ImageButton android:id="@+id/dBL" android:src="@drawable/ic_down_left"  android:contentDescription="Back left"     style="@style/Pad"/>
                    <ImageButton android:id="@+id/dB"  android:src="@drawable/ic_down"       android:contentDescription="Back"          style="@style/Pad"/>
                    <ImageButton android:id="@+id/dBR" android:src="@drawable/ic_down_right" android:contentDescription="Back right"    style="@style/Pad"/>
                </GridLayout>

                <Space android:layout_width="20dp" android:layout_height="1dp"/>

                <!-- Camera tilt and lights -->
                <LinearLayout
                    android:id="@+id/sideControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="invisible">
                    <ImageButton android:id="@+id/btnCU"    android:src="@drawable/ic_cam_up"   android:contentDescription="Camera up"   style="@style/Pad"/>
                    <ImageButton android:id="@+id/btnLight" android:src="@drawable/ic_light"    android:contentDescription="Lights"      style="@style/Pad"/>
                    <ImageButton android:id="@+id/btnCD"    android:src="@drawable/ic_cam_down" android:contentDescription="Camera down" style="@style/Pad"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Sound: car microphone on/off, and hold-to-talk through the car speaker -->
            <LinearLayout
                android:id="@+id/audioRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="invisible">
                <ImageButton android:id="@+id/btnMute" android:src="@drawable/ic_volume_on" android:contentDescription="Car sound on or off" style="@style/Pad"/>
                <Button
                    android:id="@+id/btnTalk"
                    android:layout_width="240dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_pill"
                    android:drawableStart="@drawable/ic_mic"
                    android:drawablePadding="10dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Hold to talk"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Discovery screen (shown first) -->
    <LinearLayout
        android:id="@+id/layoutDiscovery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0B1030">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminateTint="#2433C8"/>

        <TextView
            android:id="@+id/tvDiscovery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Searching for car..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Try Again"
            android:visibility="gone"
            android:backgroundTint="#2433C8"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</FrameLayout>
